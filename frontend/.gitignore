# Frontend-specific overrides
# The root .gitignore already covers most cases; this file adds
# frontend-only entries.

# Node
node_modules/
dist/
.cache/
.vite/

# Lockfile noise (keep package-lock.json committed, but ignore .yarn / .pnp)
.yarn/
.pnp.*

# Build artifacts
build/
out/

# Coverage / test
coverage/
.nyc_output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.lint-cache/

# Editor
.idea/
.vscode/
*.iml

# Env
.env
.env.local
.env.*.local
*.env
!.env.example
